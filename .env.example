# VoxSplit Environment Configuration Example
APP_NAME=VoxSplit
APP_VERSION=0.1.0
DEBUG=false
API_V1_PREFIX=/api/v1

# Audio Specs
SAMPLE_RATE=16000
CHANNELS=1
AUDIO_MAX_FILE_SIZE_BYTES=104857600

# VAD Hyperparameters
VAD_FRAME_DURATION_MS=30
VAD_AGGRESSIVENESS=3
VAD_PADDING_DURATION_MS=300
VAD_MIN_SPEECH_DURATION_MS=250
VAD_MAX_SPEECH_DURATION_SEC=28.0
VAD_ENERGY_THRESHOLD_DB=-42.0

# Diarization
SPEAKER_SIMILARITY_THRESHOLD=0.72
DIARIZATION_WINDOW_SEC=1.5
DIARIZATION_HOP_SEC=0.75
N_MFCC=24
MAX_SPEAKERS=10

# ASR (faster-whisper)
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_CPU_THREADS=4
WHISPER_LANGUAGE=
WHISPER_WORD_TIMESTAMPS=true

# Streaming WebSocket
WS_BUFFER_CHUNK_SEC=1.5
WS_SILENCE_TIMEOUT_SEC=0.8

